# AI-SOC Autonomous Incident Response & Ingestion Console
# Environment Configuration

# GEMINI_API_KEY: Optional fallback LLM key when Ollama local instance is unreachable.
# In Google AI Studio, injected automatically. On Vercel, set in Project Settings > Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OLLAMA_HOST: Host URL of the local or cloud Ollama daemon.
# Default: http://localhost:11434. For cloud/remote Ollama or tunnel, provide full URL.
OLLAMA_HOST="http://localhost:11434"

# OLLAMA_MODEL: Default lightweight AI model for real-time log triage and diagnostics.
# Recommended: llama3.2, mistral, deepseek-r1:1.5b, or llama3.
OLLAMA_MODEL="llama3.2"

# APP_URL: The URL where this applet or site is hosted.
# Used for OAuth callbacks, CORS validation, and self-referential endpoints.
APP_URL="MY_APP_URL"

# PORT: Local server port (ignored in Vercel serverless execution).
PORT=3000

# NODE_ENV: Application environment mode (development | production)
NODE_ENV="production"
